[
    {
        "name": "url",
        "type": "url",
        "label": "Base URL",
        "help": "The website to find URLs on. Only URLs on this host, and under its path if it has one, are returned unless **Include subdomains** is on.",
        "required": true
    },
    {
        "name": "search",
        "type": "text",
        "label": "Search term",
        "help": "Returns only URLs that contain this text, ignoring case. This filters the URLs found on the website and does not run a web search."
    },
    {
        "name": "include_subdomains",
        "type": "boolean",
        "label": "Include subdomains",
        "help": "Also returns URLs on other subdomains of the same domain, and checks common subdomains, such as docs, blog, help and support, for their own sitemaps. This can return many more URLs.",
        "default": false
    },
    {
        "name": "ignore_query_parameters",
        "type": "boolean",
        "label": "Ignore query parameters",
        "help": "Removes query parameters from the URLs found.",
        "default": true
    },
    {
        "name": "limit",
        "type": "uinteger",
        "label": "Limit",
        "help": "Maximum number of results to return and work with during one execution cycle. For information about setting limits, see [our Help Center](https://help.make.com/types-of-modules#b3ZEQ).",
        "default": 10
    }
]
