{
    "url": "/extract/jobs",
    "method": "GET",
    "qs": {
        "job_id": "{{parameters.job_id}}",
        "status": "{{parameters.status}}",
        "output": "{{parameters.output}}",
        "start_date": "{{if(parameters.start_date, formatDate(parameters.start_date, 'YYYY-MM-DDTHH:mm:ssZ', 'UTC'), parameters.start_date)}}",
        "end_date": "{{if(parameters.end_date, formatDate(parameters.end_date, 'YYYY-MM-DDTHH:mm:ssZ', 'UTC'), parameters.end_date)}}",
        "page_size": 100
    },
    "response": {
        "iterate": "{{body.jobs}}",
        "limit": "{{parameters.limit}}",
        "output": "{{item}}"
    },
    "pagination": {
        "qs": {
            "page": "{{pagination.page}}"
        },
        "condition": "{{body.page < body.page_count}}"
    }
}
