[
    { "name": "url", "type": "url", "label": "URL", "help": "The public web page to extract, starting with `http://` or `https://`.", "required": true },
    {
        "name": "formats",
        "type": "select",
        "label": "Output formats",
        "help": "The formats to return the content in.",
        "multiple": true,
        "default": ["html"],
        "options": [
            { "label": "HTML", "value": "html" },
            { "label": "Markdown", "value": "markdown" }
        ]
    },
    { "name": "render_js", "type": "boolean", "label": "Render JavaScript", "help": "Loads pages in a browser before extracting them, for pages that need JavaScript. It is slower and uses more tokens.", "default": false },
    {
        "name": "wait_until",
        "type": "select",
        "label": "Wait until",
        "help": "The page load event to wait for before extracting the page. Setting any wait option turns on **Render JavaScript**.",
        "options": [
            { "label": "Commit", "value": "commit" },
            { "label": "DOM content loaded", "value": "domcontentloaded" },
            { "label": "Load", "value": "load" },
            { "label": "Network idle", "value": "networkidle" }
        ]
    },
    {
        "name": "wait_for",
        "type": "text",
        "label": "Wait for selector",
        "help": "A CSS selector or XPath to wait for before extracting the page. For example, `#content`. Setting any wait option turns on **Render JavaScript**."
    },
    {
        "name": "wait_timeout",
        "type": "uinteger",
        "label": "Wait timeout",
        "help": "Extra time to wait after the page is ready, in milliseconds, from `0` to `30000`. Setting any wait option turns on **Render JavaScript**.",
        "validate": { "max": 30000 }
    },
    {
        "name": "proxy_country",
        "type": "text",
        "label": "Proxy country",
        "help": "A two-letter country code for the proxy, in capital letters. For example, `US` or `GB`. If left empty, the country is chosen from the target URL.",
        "validate": { "pattern": "^[A-Z]{2}$" }
    },
    {
        "name": "proxy_type",
        "type": "select",
        "label": "Proxy type",
        "help": "The type of proxy used to load pages.",
        "default": "residential",
        "options": [
            { "label": "Residential", "value": "residential" },
            { "label": "Datacenter", "value": "datacenter" }
        ]
    },
    {
        "name": "headers",
        "type": "array",
        "label": "Custom HTTP headers",
        "help": "HTTP headers to send to the target website.",
        "spec": [
            { "name": "key", "type": "text", "label": "Name", "required": true },
            { "name": "value", "type": "text", "label": "Value", "required": true }
        ]
    }
]
