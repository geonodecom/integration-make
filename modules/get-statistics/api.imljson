{
    "url": "/statistics",
    "method": "GET",
    "qs": {
        "start_date": "{{formatDate(parameters.start_date, 'YYYY-MM-DDTHH:mm:ssZ', 'UTC')}}",
        "end_date": "{{formatDate(parameters.end_date, 'YYYY-MM-DDTHH:mm:ssZ', 'UTC')}}"
    },
    "response": {
        "output": "{{body}}"
    }
}
