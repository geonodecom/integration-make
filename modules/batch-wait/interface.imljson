[
    { "name": "job_id", "type": "text", "label": "Job ID" },
    { "name": "status", "type": "text", "label": "Status" },
    {
        "name": "batch_config",
        "type": "collection",
        "label": "Batch Config",
        "spec": [
            { "name": "render_js", "type": "boolean", "label": "Rendered with JS" },
            { "name": "formats", "type": "array", "label": "Formats", "spec": { "type": "text" } },
            {
                "name": "proxy",
                "type": "collection",
                "label": "Proxy",
                "spec": [
                    { "name": "country", "type": "text", "label": "Country" },
                    { "name": "type", "type": "text", "label": "Type" }
                ]
            },
            {
                "name": "wait_config",
                "type": "collection",
                "label": "Wait Config",
                "spec": [
                    { "name": "wait_until", "type": "text", "label": "Wait Until" },
                    { "name": "wait_for", "type": "text", "label": "Wait For Selector" },
                    { "name": "wait_timeout", "type": "number", "label": "Wait Timeout (ms)" }
                ]
            }
        ]
    },
    {
        "name": "token_summary",
        "type": "collection",
        "label": "Token Summary",
        "spec": [
            { "name": "tokens_charged_total", "type": "number", "label": "Tokens Charged Total" },
            { "name": "tokens_reserved", "type": "number", "label": "Tokens Reserved" }
        ]
    },
    { "name": "total_urls", "type": "number", "label": "Total URLs" },
    { "name": "completed_urls", "type": "number", "label": "Completed URLs" },
    { "name": "failed_urls", "type": "number", "label": "Failed URLs" },
    { "name": "cancelled_urls", "type": "number", "label": "Cancelled URLs" },
    { "name": "pending_urls", "type": "number", "label": "Pending URLs" },
    { "name": "invalid_urls", "type": "array", "label": "Invalid URLs", "spec": { "type": "text" } },
    { "name": "created_at", "type": "date", "label": "Created At" },
    { "name": "completed_at", "type": "date", "label": "Completed At" },
    {
        "name": "results",
        "type": "array",
        "label": "Item Results (slice)",
        "spec": {
            "type": "collection",
            "spec": [
                { "name": "input_index", "type": "number", "label": "Input Index" },
                { "name": "url", "type": "url", "label": "URL" },
                { "name": "status", "type": "text", "label": "Status" },
                { "name": "error_code", "type": "text", "label": "Error Code" },
                { "name": "error_message", "type": "text", "label": "Error Message" },
                {
                    "name": "data",
                    "type": "collection",
                    "label": "Data",
                    "spec": [
                        { "name": "html", "type": "text", "label": "HTML" },
                        { "name": "markdown", "type": "text", "label": "Markdown" },
                        { "name": "links", "type": "array", "label": "Links", "spec": { "type": "url" } }
                    ]
                },
                {
                    "name": "metadata",
                    "type": "collection",
                    "label": "Metadata",
                    "spec": [
                        { "name": "http_status", "type": "number", "label": "HTTP Status" },
                        { "name": "duration_ms", "type": "number", "label": "Duration (ms)" },
                        { "name": "retry_count", "type": "number", "label": "Retry Count" },
                        { "name": "tokens_charged", "type": "number", "label": "Tokens Charged" }
                    ]
                }
            ]
        }
    }
]
