{
    "baseUrl": "https://scraper.geonode.io/v1",
    "headers": {
        "X-Api-Key": "{{connection.apiKey}}",
        "X-Geonode-Client": "make/1",
        "Accept": "application/json"
    },
    "response": {
        "error": {
            "message": "[{{statusCode}}] {{ifempty(body.error.message, ifempty(body.message, ifempty(body.detail[1].msg, ifempty(body.detail, 'Unknown error'))))}}{{if(ifempty(body.error.code, body.code), ' (error code: ', '')}}{{ifempty(body.error.code, body.code)}}{{if(ifempty(body.error.code, body.code), ')', '')}}",
            "400": {
                "type": "DataError",
                "message": "[{{statusCode}}] {{ifempty(body.error.message, ifempty(body.message, ifempty(body.detail[1].msg, ifempty(body.detail, 'Unknown error'))))}}{{if(ifempty(body.error.code, body.code), ' (error code: ', '')}}{{ifempty(body.error.code, body.code)}}{{if(ifempty(body.error.code, body.code), ')', '')}}"
            },
            "401": {
                "type": "InvalidAccessTokenError",
                "message": "[{{statusCode}}] {{ifempty(body.error.message, ifempty(body.message, ifempty(body.detail[1].msg, ifempty(body.detail, 'Unknown error'))))}}{{if(ifempty(body.error.code, body.code), ' (error code: ', '')}}{{ifempty(body.error.code, body.code)}}{{if(ifempty(body.error.code, body.code), ')', '')}}"
            },
            "408": {
                "type": "ConnectionError",
                "message": "[{{statusCode}}] {{ifempty(body.error.message, ifempty(body.message, ifempty(body.detail[1].msg, ifempty(body.detail, 'Unknown error'))))}}{{if(ifempty(body.error.code, body.code), ' (error code: ', '')}}{{ifempty(body.error.code, body.code)}}{{if(ifempty(body.error.code, body.code), ')', '')}}"
            },
            "422": {
                "type": "DataError",
                "message": "[{{statusCode}}] {{ifempty(body.error.message, ifempty(body.message, ifempty(body.detail[1].msg, ifempty(body.detail, 'Unknown error'))))}}{{if(ifempty(body.error.code, body.code), ' (error code: ', '')}}{{ifempty(body.error.code, body.code)}}{{if(ifempty(body.error.code, body.code), ')', '')}}"
            }
        }
    },
    "log": {
        "sanitize": [
            "request.headers.x-api-key"
        ]
    }
}
