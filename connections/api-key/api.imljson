{
    "url": "https://scraper.geonode.io/v1/statistics",
    "method": "GET",
    "headers": {
        "X-Api-Key": "{{parameters.apiKey}}",
        "X-Geonode-Client": "make/1"
    },
    "response": {
        "error": {
            "type": {
                "401": "InvalidAccessTokenError",
                "403": "InvalidAccessTokenError"
            },
            "message": "[{{statusCode}}] {{ifempty(body.message, 'Invalid API key')}}{{if(body.code, ' (error code: ', '')}}{{body.code}}{{if(body.code, ')', '')}}"
        },
        "data": {
            "apiKey": "{{parameters.apiKey}}"
        }
    },
    "log": {
        "sanitize": [
            "request.headers.x-api-key"
        ]
    }
}
